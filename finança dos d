<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#070a0f">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>MRT Finanças</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<style>
:root {
  --bg: #070a0f;
  --surface: #0d1117;
  --surface2: #131920;
  --border: #1e2a35;
  --green: #00e87a;
  --green-dim: #00e87a22;
  --red: #ff4d6d;
  --red-dim: #ff4d6d22;
  --yellow: #ffd60a;
  --yellow-dim: #ffd60a18;
  --text: #e8f0f7;
  --muted: #4a5c6a;
  --mono: 'Space Mono', monospace;
  --sans: 'Syne', sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

html, body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  min-height: 100vh;
  overscroll-behavior: none;
}

body {
  max-width: 480px;
  margin: 0 auto;
  padding-bottom: 90px;
}

/* ── NOISE OVERLAY ── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
  opacity: 0.4;
}

/* ── HEADER ── */
.header {
  padding: 24px 20px 12px;
  position: relative;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.logo {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--green);
  text-transform: uppercase;
}

.sync-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 8px var(--green);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ── SALDO HERO ── */
.saldo-hero {
  padding: 20px 20px 8px;
  position: relative;
}

.saldo-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 6px;
}

.saldo-valor {
  font-family: var(--mono);
  font-size: 42px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1;
  transition: color 0.4s;
}

.saldo-valor.positivo { color: var(--green); }
.saldo-valor.negativo { color: var(--red); }
.saldo-valor.neutro { color: var(--text); }

.saldo-subinfo {
  display: flex;
  gap: 20px;
  margin-top: 16px;
}

.sub-item {
  flex: 1;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 14px;
}

.sub-label {
  font-size: 9px;
  font-family: var(--mono);
  letter-spacing: 0.12em;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 4px;
}

.sub-valor {
  font-family: var(--mono);
  font-size: 16px;
  font-weight: 700;
}

.sub-valor.g { color: var(--yellow); }
.sub-valor.d { color: var(--red); }
.sub-valor.r { color: var(--green); }

/* ── TABS ── */
.tabs {
  display: flex;
  margin: 16px 20px 0;
  background: var(--surface);
  border-radius: 10px;
  padding: 4px;
  border: 1px solid var(--border);
}

.tab {
  flex: 1;
  padding: 8px;
  text-align: center;
  font-size: 12px;
  font-family: var(--mono);
  letter-spacing: 0.05em;
  color: var(--muted);
  cursor: pointer;
  border-radius: 7px;
  transition: all 0.2s;
  user-select: none;
}

.tab.active {
  background: var(--surface2);
  color: var(--text);
  box-shadow: 0 1px 4px rgba(0,0,0,0.4);
}

/* ── PANELS ── */
.panel { display: none; padding: 16px 20px 0; }
.panel.active { display: block; }

/* ── INPUT CARD ── */
.input-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 12px;
}

.input-card-title {
  font-size: 10px;
  font-family: var(--mono);
  letter-spacing: 0.15em;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 10px;
}

.input-row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.inp {
  flex: 1;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 11px 14px;
  color: var(--text);
  font-family: var(--mono);
  font-size: 13px;
  outline: none;
  transition: border-color 0.2s;
  width: 100%;
}

.inp:focus { border-color: var(--green); }
.inp::placeholder { color: var(--muted); font-size: 12px; }

.btn-add {
  background: var(--green);
  color: #000;
  border: none;
  border-radius: 8px;
  width: 42px;
  height: 42px;
  font-size: 22px;
  font-weight: 700;
  cursor: pointer;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.1s, background 0.2s;
  line-height: 1;
}

.btn-add:active { transform: scale(0.93); }
.btn-add.red { background: var(--red); }
.btn-add.yellow { background: var(--yellow); }

/* ── RENDA CARD ── */
.renda-card {
  background: var(--green-dim);
  border: 1px solid var(--green);
  border-radius: 14px;
  padding: 14px 16px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.renda-icon { font-size: 20px; }

.renda-info { flex: 1; }
.renda-label { font-size: 9px; font-family: var(--mono); color: var(--green); letter-spacing: 0.12em; text-transform: uppercase; }
.renda-valor { font-family: var(--mono); font-size: 18px; font-weight: 700; color: var(--green); }

.btn-edit-renda {
  background: none;
  border: 1px solid var(--green);
  color: var(--green);
  border-radius: 6px;
  padding: 5px 10px;
  font-family: var(--mono);
  font-size: 10px;
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: background 0.2s;
}

.btn-edit-renda:hover { background: var(--green-dim); }

/* ── LISTA DE ITENS ── */
.section-label {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.18em;
  color: var(--muted);
  text-transform: uppercase;
  margin: 14px 0 8px;
}

.item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 10px;
  animation: slideIn 0.25s ease;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.item-emoji { font-size: 18px; width: 28px; text-align: center; flex-shrink: 0; }

.item-info { flex: 1; min-width: 0; }
.item-nome {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-transform: capitalize;
}
.item-sub {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--muted);
  margin-top: 1px;
}

.item-valor {
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
}

.item-valor.gasto { color: var(--yellow); }
.item-valor.divida { color: var(--red); }

.btn-del {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 16px;
  cursor: pointer;
  padding: 4px;
  flex-shrink: 0;
  border-radius: 6px;
  transition: color 0.2s, background 0.2s;
  line-height: 1;
}

.btn-del:hover { color: var(--red); background: var(--red-dim); }

/* ── GRÁFICO ── */
.chart-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 12px;
}

.chart-title {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.18em;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 14px;
}

.chart-wrap { position: relative; height: 200px; }

/* ── BOTTOM NAV ── */
.bottom-nav {
  position: fixed;
  bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 480px;
  background: var(--surface);
  border-top: 1px solid var(--border);
  display: flex;
  padding: 10px 0 20px;
  z-index: 100;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  cursor: pointer;
  padding: 4px;
  border-radius: 8px;
  transition: background 0.2s;
}

.nav-icon { font-size: 20px; }
.nav-label {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--muted);
  letter-spacing: 0.05em;
}

.nav-item.active .nav-label { color: var(--green); }
.nav-item.active .nav-icon { filter: drop-shadow(0 0 4px var(--green)); }

/* ── MODAL RENDA ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.8);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.modal-overlay.open {
  opacity: 1;
  pointer-events: all;
}

.modal {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 20px 20px 0 0;
  padding: 24px 24px 40px;
  width: 100%;
  max-width: 480px;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.modal-overlay.open .modal { transform: translateY(0); }

.modal-title {
  font-size: 14px;
  font-weight: 800;
  margin-bottom: 16px;
  color: var(--green);
  font-family: var(--mono);
  letter-spacing: 0.05em;
}

.modal-inp {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px;
  color: var(--text);
  font-family: var(--mono);
  font-size: 22px;
  width: 100%;
  outline: none;
  margin-bottom: 12px;
  text-align: center;
}

.modal-inp:focus { border-color: var(--green); }

.btn-salvar {
  background: var(--green);
  color: #000;
  border: none;
  border-radius: 10px;
  padding: 14px;
  width: 100%;
  font-family: var(--mono);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: opacity 0.2s;
}

.btn-salvar:active { opacity: 0.8; }

/* ── EMPTY STATE ── */
.empty {
  text-align: center;
  padding: 32px 20px;
  color: var(--muted);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
}

.empty-icon { font-size: 32px; margin-bottom: 8px; }

/* ── LOADING ── */
.loading {
  text-align: center;
  padding: 60px 20px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 0.15em;
}

.loading-spinner {
  width: 24px; height: 24px;
  border: 2px solid var(--border);
  border-top-color: var(--green);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 12px;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ── TOAST ── */
.toast {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%) translateY(-60px);
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 20px;
  font-family: var(--mono);
  font-size: 12px;
  z-index: 300;
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  white-space: nowrap;
  pointer-events: none;
}

.toast.show { transform: translateX(-50%) translateY(0); }
.toast.success { border-color: var(--green); color: var(--green); }
.toast.error { border-color: var(--red); color: var(--red); }

/* ── CATEGORIA BADGE ── */
.cat-badge {
  font-size: 9px;
  font-family: var(--mono);
  background: var(--surface2);
  border-radius: 4px;
  padding: 2px 6px;
  color: var(--muted);
  letter-spacing: 0.05em;
  margin-top: 2px;
  display: inline-block;
}
</style>
</head>

<body>

<!-- HEADER -->
<div class="header">
  <div class="header-top">
    <span class="logo">MRT // Finanças</span>
    <div class="sync-dot" id="syncDot" title="Sincronizado"></div>
  </div>
</div>

<!-- SALDO HERO -->
<div class="saldo-hero">
  <div class="saldo-label">saldo disponível</div>
  <div class="saldo-valor neutro" id="saldoHero">R$ —</div>
  <div class="saldo-subinfo">
    <div class="sub-item">
      <div class="sub-label">renda</div>
      <div class="sub-valor r" id="rendaDisplay">R$ 0</div>
    </div>
    <div class="sub-item">
      <div class="sub-label">gastos</div>
      <div class="sub-valor g" id="gastosDisplay">R$ 0</div>
    </div>
    <div class="sub-item">
      <div class="sub-label">dívidas</div>
      <div class="sub-valor d" id="dividasDisplay">R$ 0</div>
    </div>
  </div>
</div>

<!-- TABS -->
<div class="tabs">
  <div class="tab active" onclick="switchTab('gastos')">💸 Gastos</div>
  <div class="tab" onclick="switchTab('dividas')">💳 Dívidas</div>
  <div class="tab" onclick="switchTab('grafico')">📊 Gráfico</div>
</div>

<!-- PANEL GASTOS -->
<div class="panel active" id="panel-gastos">
  <div class="input-card">
    <div class="input-card-title">// novo gasto</div>
    <div class="input-row">
      <input class="inp" id="inpGasto" placeholder="mercado 85.50" onkeydown="if(event.key==='Enter')addGasto()">
      <button class="btn-add yellow" onclick="addGasto()">+</button>
    </div>
  </div>
  <div class="section-label">// histórico de gastos</div>
  <div id="listaGastos"><div class="loading"><div class="loading-spinner"></div>carregando...</div></div>
</div>

<!-- PANEL DÍVIDAS -->
<div class="panel" id="panel-dividas">
  <div class="input-card">
    <div class="input-card-title">// nova dívida / parcela</div>
    <div class="input-row">
      <input class="inp" id="inpDivida" placeholder="cartão 250 6x" onkeydown="if(event.key==='Enter')addDivida()">
      <button class="btn-add red" onclick="addDivida()">+</button>
    </div>
  </div>
  <div class="section-label">// dívidas ativas</div>
  <div id="listaDividas"><div class="loading"><div class="loading-spinner"></div>carregando...</div></div>
</div>

<!-- PANEL GRÁFICO -->
<div class="panel" id="panel-grafico">
  <div class="renda-card">
    <span class="renda-icon">💰</span>
    <div class="renda-info">
      <div class="renda-label">renda mensal</div>
      <div class="renda-valor" id="rendaCard">R$ 0,00</div>
    </div>
    <button class="btn-edit-renda" onclick="openModal()">editar</button>
  </div>

  <div class="chart-card">
    <div class="chart-title">// distribuição financeira</div>
    <div class="chart-wrap">
      <canvas id="chartPizza"></canvas>
    </div>
  </div>

  <div class="chart-card">
    <div class="chart-title">// gastos por categoria</div>
    <div class="chart-wrap">
      <canvas id="chartCat"></canvas>
    </div>
  </div>
</div>

<!-- BOTTOM NAV -->
<nav class="bottom-nav">
  <div class="nav-item active" id="nav-gastos" onclick="switchTab('gastos')">
    <span class="nav-icon">💸</span>
    <span class="nav-label">gastos</span>
  </div>
  <div class="nav-item" id="nav-dividas" onclick="switchTab('dividas')">
    <span class="nav-icon">💳</span>
    <span class="nav-label">dívidas</span>
  </div>
  <div class="nav-item" id="nav-grafico" onclick="switchTab('grafico')">
    <span class="nav-icon">📊</span>
    <span class="nav-label">gráfico</span>
  </div>
</nav>

<!-- MODAL RENDA -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModalOutside(event)">
  <div class="modal">
    <div class="modal-title">// definir renda mensal</div>
    <input class="modal-inp" id="inpRenda" type="number" placeholder="0.00" inputmode="decimal">
    <button class="btn-salvar" onclick="salvarRenda()">SALVAR RENDA</button>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js";
import {
  initializeFirestore,
  persistentLocalCache,
  collection, addDoc, deleteDoc, doc, onSnapshot, setDoc, getDoc
} from "https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js";

// ── CONFIG ──
const firebaseConfig = {
  apiKey: "AIzaSyBg5q1i6ZprD4w_bJwLSDlLitaWSnsd-6Q",
  authDomain: "mrt-financas.firebaseapp.com",
  projectId: "mrt-financas",
  storageBucket: "mrt-financas.firebasestorage.app",
  messagingSenderId: "499178108015",
  appId: "1:499178108015:web:ffb61fd1e64bf8787f099a"
};

const app = initializeApp(firebaseConfig);

// ✅ API moderna, sem deprecation
const db = initializeFirestore(app, {
  localCache: persistentLocalCache()
});

// ── UID anônimo ──
const uid = localStorage.getItem("uid") || crypto.randomUUID();
localStorage.setItem("uid", uid);

const gastosRef   = collection(db, "users", uid, "gastos");
const dividasRef  = collection(db, "users", uid, "dividas");
const rendaDocRef = doc(db, "users", uid, "config", "renda");

// ── Estado ──
let gastos  = [];
let dividas = [];
let renda   = 0;
let chartPizza = null;
let chartCat   = null;

// ── Categorias automáticas ──
const cats = {
  mercado:    { emoji: '🛒', label: 'Mercado' },
  supermercado: { emoji: '🛒', label: 'Mercado' },
  ifood:      { emoji: '🍔', label: 'Delivery' },
  delivery:   { emoji: '🍔', label: 'Delivery' },
  uber:       { emoji: '🚗', label: 'Transporte' },
  gasolina:   { emoji: '⛽', label: 'Transporte' },
  combustível:{ emoji: '⛽', label: 'Transporte' },
  farmácia:   { emoji: '💊', label: 'Saúde' },
  remédio:    { emoji: '💊', label: 'Saúde' },
  academia:   { emoji: '💪', label: 'Saúde' },
  aluguel:    { emoji: '🏠', label: 'Moradia' },
  luz:        { emoji: '💡', label: 'Moradia' },
  água:       { emoji: '💧', label: 'Moradia' },
  internet:   { emoji: '📡', label: 'Moradia' },
  celular:    { emoji: '📱', label: 'Moradia' },
  netflix:    { emoji: '🎬', label: 'Lazer' },
  spotify:    { emoji: '🎵', label: 'Lazer' },
  jogo:       { emoji: '🎮', label: 'Lazer' },
  bar:        { emoji: '🍺', label: 'Lazer' },
  restaurante:{ emoji: '🍽️', label: 'Lazer' },
  cartão:     { emoji: '💳', label: 'Dívida' },
  empréstimo: { emoji: '🏦', label: 'Dívida' },
  roupa:      { emoji: '👕', label: 'Vestuário' },
  tênis:      { emoji: '👟', label: 'Vestuário' },
};

function detectCat(txt) {
  const lower = txt.toLowerCase();
  for (const [key, val] of Object.entries(cats)) {
    if (lower.includes(key)) return val;
  }
  return { emoji: '📌', label: 'Outros' };
}

// ── Parse valor do texto ──
function parseValor(txt) {
  const match = txt.replace(',', '.').match(/(\d+(\.\d+)?)/);
  return match ? parseFloat(match[0]) : 0;
}

function parseParcelas(txt) {
  const match = txt.match(/(\d+)\s*[xX]/);
  return match ? parseInt(match[1]) : 1;
}

function fmtBRL(v) {
  return 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// ── Carregar renda ──
async function loadRenda() {
  try {
    const snap = await getDoc(rendaDocRef);
    if (snap.exists()) {
      renda = snap.data().valor || 0;
      updateRendaUI();
    }
  } catch(e) {}
}

function updateRendaUI() {
  document.getElementById('rendaDisplay').textContent = fmtBRL(renda);
  document.getElementById('rendaCard').textContent = fmtBRL(renda);
}

// ── Listeners Firestore ──
onSnapshot(gastosRef, snap => {
  gastos = snap.docs.map(d => ({ id: d.id, ...d.data() }));
  render();
});

onSnapshot(dividasRef, snap => {
  dividas = snap.docs.map(d => ({ id: d.id, ...d.data() }));
  render();
});

// ── Adicionar gasto ──
window.addGasto = async () => {
  const txt = document.getElementById('inpGasto').value.trim();
  if (!txt) return;
  const valor = parseValor(txt);
  if (!valor) { showToast('Informe o valor! ex: mercado 50', 'error'); return; }
  const { emoji, label } = detectCat(txt);
  const nome = txt.replace(/\d+([.,]\d+)?/g, '').replace(/\s+/g, ' ').trim() || txt;
  await addDoc(gastosRef, { nome, valor, emoji, categoria: label, ts: Date.now() });
  document.getElementById('inpGasto').value = '';
  showToast('Gasto adicionado ✓', 'success');
};

// ── Adicionar dívida ──
window.addDivida = async () => {
  const txt = document.getElementById('inpDivida').value.trim();
  if (!txt) return;
  const valor = parseValor(txt);
  if (!valor) { showToast('Informe o valor! ex: cartão 250 6x', 'error'); return; }
  const parcelas = parseParcelas(txt);
  const nome = txt.replace(/\d+([.,]\d+)?/g, '').replace(/[xX]/g, '').replace(/\s+/g, ' ').trim() || txt;
  const { emoji } = detectCat(txt);
  await addDoc(dividasRef, { nome, valor, parcelas, restantes: parcelas, emoji, ts: Date.now() });
  document.getElementById('inpDivida').value = '';
  showToast(`Dívida ${parcelas}x adicionada ✓`, 'success');
};

// ── Deletar ──
window.delGasto = async (id) => {
  await deleteDoc(doc(db, "users", uid, "gastos", id));
  showToast('Removido', 'success');
};

window.delDivida = async (id) => {
  await deleteDoc(doc(db, "users", uid, "dividas", id));
  showToast('Removido', 'success');
};

// ── Renda ──
window.openModal = () => {
  document.getElementById('inpRenda').value = renda || '';
  document.getElementById('modalOverlay').classList.add('open');
  setTimeout(() => document.getElementById('inpRenda').focus(), 300);
};

window.closeModalOutside = (e) => {
  if (e.target === document.getElementById('modalOverlay')) closeModal();
};

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
}

window.salvarRenda = async () => {
  const v = parseFloat(document.getElementById('inpRenda').value);
  if (!v || v < 0) { showToast('Valor inválido', 'error'); return; }
  renda = v;
  await setDoc(rendaDocRef, { valor: v });
  updateRendaUI();
  closeModal();
  render();
  showToast('Renda salva ✓', 'success');
};

// ── Render ──
function render() {
  let tg = 0, td = 0;

  // Lista gastos
  const lgEl = document.getElementById('listaGastos');
  if (gastos.length === 0) {
    lgEl.innerHTML = `<div class="empty"><div class="empty-icon">📭</div>nenhum gasto registrado</div>`;
  } else {
    lgEl.innerHTML = gastos
      .sort((a, b) => (b.ts || 0) - (a.ts || 0))
      .map(g => {
        tg += g.valor;
        return `<div class="item">
          <span class="item-emoji">${g.emoji || '📌'}</span>
          <div class="item-info">
            <div class="item-nome">${g.nome}</div>
            <span class="cat-badge">${g.categoria || 'outros'}</span>
          </div>
          <div class="item-valor gasto">${fmtBRL(g.valor)}</div>
          <button class="btn-del" onclick="delGasto('${g.id}')">✕</button>
        </div>`;
      }).join('');
  }

  // Lista dívidas
  const ldEl = document.getElementById('listaDividas');
  if (dividas.length === 0) {
    ldEl.innerHTML = `<div class="empty"><div class="empty-icon">✅</div>sem dívidas ativas</div>`;
  } else {
    ldEl.innerHTML = dividas
      .sort((a, b) => (b.ts || 0) - (a.ts || 0))
      .map(d => {
        const total = d.valor * (d.restantes || 1);
        td += total;
        return `<div class="item">
          <span class="item-emoji">${d.emoji || '💳'}</span>
          <div class="item-info">
            <div class="item-nome">${d.nome}</div>
            <div class="item-sub">${d.restantes}x de ${fmtBRL(d.valor)} = ${fmtBRL(total)}</div>
          </div>
          <div class="item-valor divida">${fmtBRL(total)}</div>
          <button class="btn-del" onclick="delDivida('${d.id}')">✕</button>
        </div>`;
      }).join('');
  }

  // Summary
  const saldo = renda - tg - td;
  const el = document.getElementById('saldoHero');
  el.textContent = fmtBRL(saldo);
  el.className = 'saldo-valor ' + (saldo > 0 ? 'positivo' : saldo < 0 ? 'negativo' : 'neutro');

  document.getElementById('gastosDisplay').textContent  = fmtBRL(tg);
  document.getElementById('dividasDisplay').textContent = fmtBRL(td);

  updateCharts(tg, td);
}

// ── Gráficos ──
function updateCharts(tg, td) {
  const livre = Math.max(0, renda - tg - td);

  // Donut
  const ctxP = document.getElementById('chartPizza').getContext('2d');
  const dataP = {
    labels: ['Gastos', 'Dívidas', 'Livre'],
    datasets: [{
      data: [tg, td, livre],
      backgroundColor: ['#ffd60a', '#ff4d6d', '#00e87a'],
      borderColor: '#0d1117',
      borderWidth: 3,
      hoverOffset: 6
    }]
  };

  if (chartPizza) {
    chartPizza.data = dataP;
    chartPizza.update();
  } else {
    chartPizza = new Chart(ctxP, {
      type: 'doughnut',
      data: dataP,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '70%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              color: '#4a5c6a',
              font: { family: 'Space Mono', size: 10 },
              padding: 16,
              boxWidth: 10
            }
          },
          tooltip: {
            callbacks: {
              label: ctx => ' ' + fmtBRL(ctx.raw)
            }
          }
        }
      }
    });
  }

  // Barras por categoria
  const catMap = {};
  gastos.forEach(g => {
    const cat = g.categoria || 'Outros';
    catMap[cat] = (catMap[cat] || 0) + g.valor;
  });

  const ctxC = document.getElementById('chartCat').getContext('2d');
  const labels = Object.keys(catMap);
  const values = Object.values(catMap);

  const dataC = {
    labels,
    datasets: [{
      label: 'R$',
      data: values,
      backgroundColor: '#ffd60a44',
      borderColor: '#ffd60a',
      borderWidth: 1,
      borderRadius: 6
    }]
  };

  if (chartCat) {
    chartCat.data = dataC;
    chartCat.update();
  } else {
    chartCat = new Chart(ctxC, {
      type: 'bar',
      data: dataC,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: ctx => ' ' + fmtBRL(ctx.raw)
            }
          }
        },
        scales: {
          x: {
            ticks: { color: '#4a5c6a', font: { family: 'Space Mono', size: 10 } },
            grid: { color: '#1e2a35' }
          },
          y: {
            ticks: {
              color: '#4a5c6a',
              font: { family: 'Space Mono', size: 10 },
              callback: v => 'R$' + v
            },
            grid: { color: '#1e2a35' }
          }
        }
      }
    });
  }
}

// ── Toast ──
window.showToast = (msg, type = 'success') => {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `toast ${type} show`;
  setTimeout(() => el.classList.remove('show'), 2200);
};

// ── Tabs ──
window.switchTab = (tab) => {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById(`panel-${tab}`).classList.add('active');
  document.querySelector(`.tab[onclick*="${tab}"]`).classList.add('active');
  document.getElementById(`nav-${tab}`).classList.add('active');
};

// ── INIT ──
loadRenda();
</script>
</body>
</html>
